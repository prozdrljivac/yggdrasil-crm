# Fictional local values only. Never use these outside local development.
# Single-quote values that contain $ so Compose treats it literally.

# PostgreSQL (reserved for future application storage integration).
YGGDRASIL_POSTGRES_DB=yggdrasil_local
YGGDRASIL_POSTGRES_USER=yggdrasil_local
YGGDRASIL_POSTGRES_PASSWORD='local-only-postgres-not-a-secret'
YGGDRASIL_POSTGRES_PORT=5432

# RabbitMQ. The backend builds its broker URL from these same values.
YGGDRASIL_RABBITMQ_USER=yggdrasil_local
YGGDRASIL_RABBITMQ_PASSWORD='local-only-rabbitmq-not-a-secret'
YGGDRASIL_RABBITMQ_VHOST=yggdrasil_local
YGGDRASIL_RABBITMQ_PORT=5672
YGGDRASIL_RABBITMQ_MANAGEMENT_PORT=15672

# Private S3-compatible storage (reserved for future application integration).
YGGDRASIL_S3_BUCKET=yggdrasil-local
YGGDRASIL_S3_ACCESS_KEY=yggdrasil-local
YGGDRASIL_S3_SECRET_KEY='local-only-seaweedfs-not-a-secret'
YGGDRASIL_S3_PORT=8333

# PDF service (reserved for future application integration).
YGGDRASIL_GOTENBERG_PORT=3000
