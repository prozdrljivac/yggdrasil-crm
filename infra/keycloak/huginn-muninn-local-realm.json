      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [
        {
          "type": "password",
          "value": "${LOCAL_NONOWNER_PASSWORD}",
          "temporary": false
        }
      ],
      "clientRoles": {
        "account": ["manage-account", "view-profile"]
      }
    }
  ]
